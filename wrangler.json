{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-code-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "vars": {
    "GITHUB_APP_ID": "5155799",
    "TRIAGE_ESCALATION_FLOOR": "0.5",
    "AI_GATEWAY_NAME": "default"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PR_COORDINATOR",
        "class_name": "PrReviewCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrReviewCoordinator"]
    }
  ]
}
